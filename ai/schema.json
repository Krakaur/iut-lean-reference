{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IUT Lean Reference claim record",
  "type": "object",
  "required": [
    "claim_id",
    "source_id",
    "localizers",
    "epistemic_status",
    "plain_statement",
    "lean_declarations",
    "dependencies",
    "discriminant",
    "gates",
    "does_not_establish"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^T(?:0[1-9]|1[01])$"},
    "source_id": {"type": "string"},
    "localizers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "epistemic_status": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "plain_statement": {"type": "string"},
    "lean_declarations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "discriminant": {"type": "string"},
    "gates": {
      "type": "object",
      "required": ["semantic", "kernel", "fidelity", "replication"],
      "properties": {
        "semantic": {"type": "string"},
        "kernel": {"type": "string"},
        "fidelity": {"type": "string"},
        "replication": {"type": "string"}
      }
    },
    "does_not_establish": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
