{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IUT Lean Reference application record",
  "type": "object",
  "required": [
    "application_id",
    "source_id",
    "localizers",
    "epistemic_status",
    "task",
    "lean_declarations",
    "dependencies",
    "positive_test",
    "negative_test",
    "discriminant",
    "gates",
    "does_not_establish"
  ],
  "properties": {
    "application_id": {"type": "string", "pattern": "^APP[0-9]{2}$"},
    "source_id": {"type": "string"},
    "localizers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "epistemic_status": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "task": {"type": "string"},
    "lean_declarations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "positive_test": {"type": "string"},
    "negative_test": {"type": "string"},
    "discriminant": {"type": "string"},
    "gates": {"type": "object"},
    "does_not_establish": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": true
}
